# Copy to .env and populate keys for Live API Mode (Verified Replay Mode runs at $0 without keys)
ANTHROPIC_API_KEY=

# Optional Credit Shield controls
# Leave AUTHOR_PASSCODE empty for local/author live mode; set a string before public deployment
AUTHOR_PASSCODE=
DAILY_LIVE_BUDGET_USD=2.00

# Optional model overrides
ANTHROPIC_SONNET_MODEL=claude-sonnet-5-5
ANTHROPIC_HAIKU_MODEL=claude-haiku-5-5
